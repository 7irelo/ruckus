# Ruckus configuration (all optional)
#
# These only change the DEFAULT value of the matching flag. An explicitly
# passed flag always wins. Copy to .env and adjust, or export directly.

# Path to the SQLite run-history database.
# Overrides --db-path. A leading ~ is expanded.
# Default: ~/.ruckus/ruckus.db
RUCKUS_DB_PATH=~/.ruckus/ruckus.db

# Output format: json | human
# "human" is equivalent to passing --human.
# Default: json
RUCKUS_LOG_FORMAT=json

# Default experiment settings.
# Any Go duration string ("30s", "2m", "1m30s").
# The 5m hard safety cap still applies unless --unsafe-max-duration is passed.
# Defaults: 30s and 10s
RUCKUS_DEFAULT_DURATION=30s
RUCKUS_DEFAULT_INTERVAL=10s
